# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Neon Postgres -----------------------------------------------------------
# From the Neon dashboard > your project > Connection Details.
# DATABASE_URL = the POOLED connection string (host contains "-pooler"). Used at
#   runtime; required for serverless to avoid exhausting connections.
# DIRECT_URL   = the DIRECT (non-pooled) connection string. Used by Prisma for
#   migrations only. Both should include `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Environment -------------------------------------------------------------
NODE_ENV="development"

# --- API access --------------------------------------------------------------
# Comma-separated origins allowed to call the API. The web app's origin plus the
# published Chrome extension id. In development, any chrome-extension:// origin is
# allowed automatically, so you can leave this empty while testing locally.
# Example: "http://localhost:3000,chrome-extension://abcdefghijklmnop..."
ALLOWED_ORIGINS=""

# --- TEMPORARY dev auth ------------------------------------------------------
# Until real auth (Clerk) lands, requests without an `x-user-id` header fall back
# to this user. Set it to the id printed by `npm run db:seed`.
DEV_USER_ID=""

# --- Groq (job extraction) ---------------------------------------------------
# Powers POST /api/extract. Server-side only — never expose this in the extension.
# Get a key at https://console.groq.com.
# GROQ_MODEL extracts the structured fields. Defaults to openai/gpt-oss-20b — cache-eligible on
#   Groq (both prompts send the page as the prompt prefix, so the details + application calls
#   reuse the same cached page at 50% off; cached tokens also don't count toward TPM). Bump to
#   openai/gpt-oss-120b if 20B misses fields on your postings.
# GROQ_DESCRIPTION_MODEL trims the job description to its useful parts (defaults to the fast,
#   cheap llama-3.1-8b-instant; it runs in parallel with the field call so it's off the hot path).
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_DESCRIPTION_MODEL="llama-3.1-8b-instant"

# --- OpenRouter (AI cover letter) --------------------------------------------
# Powers the streaming cover letter (POST /api/cover-letter) — creative prose, separate from Groq's
# extraction. OpenRouter fronts many providers behind one OpenAI-compatible API, giving us model
# fallback (a chain tried in order) and prompt caching for the static system prompt. Get a key at
# https://openrouter.ai (prefix "sk-or-v1-"). Server-side only — never ship it to the extension.
#   COVER_LETTER_MODEL           = primary model slug (Claude Haiku 4.5).
#   COVER_LETTER_FALLBACK_MODELS = comma-separated slugs OpenRouter falls back to, in order.
OPENROUTER_API_KEY=""
COVER_LETTER_MODEL="anthropic/claude-haiku-4.5"
COVER_LETTER_FALLBACK_MODELS="z-ai/glm-4.7-flash,google/gemini-3.1-flash-lite"

# --- Firecrawl (save a job from a URL) ---------------------------------------
# Powers POST /api/jobs/import — the web app's "paste a posting link" import. ONE
# Firecrawl /v2/scrape call does the structured extraction (its own LLM) + branding/logo,
# so this path adds NO Groq spend. Server-side only — never expose it in the extension.
# Get a key at https://www.firecrawl.dev (Settings > API Keys; prefix "fc-").
FIRECRAWL_API_KEY=""

# --- Cloudflare R2 (user-uploaded documents) ---------------------------------
# Object storage for the Documents page (resumes, cover letters). Neon's split-storage
# pattern: bytes in R2, metadata in the Document table. R2 is S3-compatible, so we use
# @aws-sdk/client-s3 pointed at the R2 endpoint. Server-side ONLY — never in the client.
# When all four are set the R2 provider activates (lib/server/storage/document-storage.ts);
# otherwise uploads fail with a clear "storage isn't set up yet" error.
# Create an R2 bucket + an "Object Read & Write" API token in the Cloudflare dashboard.
# Keep the bucket PRIVATE (no public r2.dev URL / custom domain) — files are served only
# through the userId-scoped /api/documents/:id/raw proxy. (EU-jurisdiction buckets need an
# ".eu." endpoint — update the endpoint in document-storage.ts if you use one.)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# --- context.dev (evaluation only) -------------------------------------------
# An alternative structured-extraction provider for the URL import, evaluated against
# Firecrawl with the SAME schema + prompt (lib/llm/context-dev.ts). Its /v1/web/extract
# endpoint takes a JSON Schema + instructions and can crawl multiple pages. NOT wired into
# the live import path. Server-side only. Key prefix "ctxt_secret_".
CONTEXT_DEV_API_KEY=""

# --- Embeddings (extension autofill field matching) --------------------------
# Powers the semantic matching behind the extension's one-click Autofill: the backend embeds the
# page's input-field labels + the saved application questions and matches them by cosine similarity
# (POST /api/jobs/:id/application/autofill-match). One tiny batched call per autofill (~sub-cent).
# Reuses the OPENROUTER_API_KEY above (OpenAI-compatible endpoint) — no separate OpenAI account.
# EMBEDDINGS_MODEL is optional (defaults to openai/text-embedding-3-small). This is the only
# embeddings seam (lib/llm/embeddings.ts) — swap to self-hosted FastEmbed later by changing that file.
EMBEDDINGS_MODEL="openai/text-embedding-3-small"

# --- Upstash QStash (reminder scheduling + digest cron) ----------------------
# QStash is the scheduler that actually FIRES reminders. The app publishes a one-shot delivery
# per dated reminder (callback to /api/reminders/fire at its due time) plus an hourly digest cron
# (callback to /api/cron/reminders-digest). The two signing keys let those routes verify a request
# truly came from QStash. Get them at https://console.upstash.com/qstash. All optional: without a
# token the scheduler no-ops and reminder CRUD still works (reminders just won't fire).
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Resend (reminder + digest email) ----------------------------------------
# The email channel for reminders/digests. Get a key at https://resend.com (prefix "re_").
# EMAIL_FROM must use a domain you have verified in Resend. Optional: without a key, email sends
# no-op with a logged warning (in-app + extension still deliver). Server-side only.
RESEND_API_KEY=""
EMAIL_FROM="JobTracker <reminders@jobtracker.app>"

# --- Public app URL (QStash callback target) ---------------------------------
# The origin QStash calls back to for the worker + digest cron. In production set this to the
# deployed origin (e.g. https://app.jobtracker.com). In local dev QStash CANNOT reach a bare
# localhost — use the Upstash QStash dev server (see scripts/curl/README.md) or a public tunnel.
APP_URL="http://localhost:3100"

# --- Neon Auth (Better Auth) — webapp auth. See docs/AUTH.md ---
# Auth URL: Neon Console → Project → Branch → Auth → Configuration.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# >= 32 chars. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
