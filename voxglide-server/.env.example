# voxglide proxy configuration — copy to .env and fill in.
# The proxy holds the LLM key; it never reaches the browser.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port 3200 (NOT 3100 — the webapp/backend runs on 3100 and the Chrome extension is
# hard-wired to it). The proxy must stay off 3100 to avoid colliding with the extension.
PORT=3200

# Optional overrides:
# LLM_MODEL=claude-sonnet-4-20250514   # default for anthropic
# ALLOWED_ORIGINS=http://localhost:3100   # default "*" (any origin)
